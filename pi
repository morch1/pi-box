#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
DOCKER_BIN="${DOCKER_BIN:-docker}"

REBUILD=false
ARGS=()
for arg in "$@"; do
  case "$arg" in
    update)
      REBUILD=true
      ;;
    *)
      ARGS+=("$arg")
      ;;
  esac
done

export USER_UID=$(id -u)
export USER_GID=$(id -g)
export WORKSPACE="/workspaces/$(basename "$(pwd)")"

EXISTS=$("${DOCKER_BIN}" image inspect "morchv/pi-box:local-${USER_UID}" >/dev/null 2>&1 && echo "true" || echo "false")

if [ "$REBUILD" = true ] || [ "$EXISTS" = "false" ]; then
  "${DOCKER_BIN}" build --no-cache \
    --build-arg USER_UID="${USER_UID}" \
    --build-arg USER_GID="${USER_GID}" \
    --build-arg USERNAME=pi \
    -t "morchv/pi-box:local-${USER_UID}" \
    "$SCRIPT_DIR"
fi

if [ "$REBUILD" = false ]; then
  "${DOCKER_BIN}" run --rm -it \
    -e TERM \
    -e LOCAL_LLM_API_KEY \
    -e FIRECRAWL_API_KEY \
    -e FIRECRAWL_API_URL \
    -v "${PI_BOX_HOME:-${HOME}/.pi-box-home}:/home/pi" \
    -v "$(pwd):$WORKSPACE" \
    -w "$WORKSPACE" \
    --security-opt=no-new-privileges \
    --cap-drop=ALL \
    "morchv/pi-box:local-${USER_UID}" \
    pi "${ARGS[@]}"
fi
