{
  "name": "Dev container base",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}_devcontainer",
  "remoteUser": "dev",
  "postCreateCommand": "[ -f requirements.txt ] && python -m pip install -r requirements.txt || :",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Development server",
      "onAutoForward": "notify"
    }
  }
}
